{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/writings",
      "destination": "/musings",
      "permanent": true
    },
    {
      "source": "/writings/:slug",
      "destination": "/musings/:slug",
      "permanent": true
    }
  ]
}
